# Copy these lines into .env.local and fill them in.

# Neon, production branch. Pooled connection, role hh_app. This is the only
# database URL Vercel gets. Written by `npm run db:app-password`. Never create
# hh_app in the Neon console: console roles can read and write every table.
DATABASE_URL=

# Neon, production branch. Direct connection (host without -pooler), owner role.
# Laptop only, for migrations. Never add it to Vercel.
DATABASE_URL_OWNER=

# Cloudflare R2. An API token limited to this bucket, with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# The bucket's public custom domain, such as https://img.hhappsolutions.com
NEXT_PUBLIC_IMAGE_BASE=
